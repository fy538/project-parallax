# tools/asset-source/.env.example — stock-library API keys.
#
# All three providers are free with rate limits. At least one is required
# for `source.py` to return anything; missing keys mean that provider is
# silently skipped (returns []).
#
# Copy:  cp tools/asset-source/.env.example tools/asset-source/.env
# Then edit with real keys. Real .env is gitignored.

# ─── Pexels (photos + videos) ──────────────────────────────────────────────
# Free tier: 200 requests/hour, 20,000/month.
# Header auth: { Authorization: <key> }.
# Get one: https://www.pexels.com/api/new/
PEXELS_API_KEY=...

# ─── Pixabay (photos + videos) ─────────────────────────────────────────────
# Free tier: 5000 requests/hour. Key is a query param (no header auth).
# Get one: https://pixabay.com/api/docs/
PIXABAY_API_KEY=...

# ─── Unsplash (photos only) ────────────────────────────────────────────────
# Free demo tier: 50 requests/hour. Production tier requires app review.
# Header auth: { Authorization: Client-ID <key> }.
# Get one: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=...
