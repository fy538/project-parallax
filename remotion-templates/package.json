{
  "name": "geopolitics-video-templates",
  "version": "1.0.0",
  "description": "Remotion template library for geopolitics video production",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render",
    "preview": "npx remotion preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:baseline": "rm -rf src/__tests__/baselines && vitest run",
    "test:visual": "vitest run src/__tests__/templates.test.ts",
    "test:unit": "vitest run src/__tests__/lint-conventions.test.ts src/__tests__/useCameraStagger.test.ts src/__tests__/EpisodeSeries.test.ts src/__tests__/useBeatSync.test.ts src/__tests__/useEpisodeColorEmphasis.test.ts src/__tests__/useDirection.test.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "create-template": "node scripts/create-template.mjs",
    "lint": "node scripts/lint-conventions.mjs",
    "lint:fix": "node scripts/lint-conventions.mjs --fix",
    "deploy": "node scripts/deploy-lambda.mjs",
    "deploy:teardown": "node scripts/deploy-lambda.mjs --teardown",
    "render:lambda": "node scripts/render-lambda.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@remotion/cli": "^4.0.456",
    "@remotion/google-fonts": "^4.0.456",
    "@remotion/lambda": "^4.0.456",
    "@remotion/light-leaks": "^4.0.456",
    "@remotion/player": "^4.0.456",
    "@remotion/sfx": "^4.0.456",
    "@remotion/transitions": "^4.0.456",
    "@types/react-dom": "^19.2.3",
    "d3-interpolate": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-scale-chromatic": "^3.0.0",
    "mapbox-gl": "^3.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.1",
    "remotion": "^4.0.456",
    "topojson-client": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.456",
    "@remotion/renderer": "^4.0.456",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-scale": "^4.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^25.6.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/topojson-client": "^3.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
