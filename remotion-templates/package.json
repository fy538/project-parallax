{
  "name": "geopolitics-video-templates",
  "version": "1.0.0",
  "description": "Remotion template library for geopolitics video production",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render",
    "preview": "npx remotion preview",
    "clean:browsers": "node scripts/kill-stale-browsers.mjs",
    "pretest": "node scripts/kill-stale-browsers.mjs",
    "test": "vitest run",
    "posttest": "node scripts/kill-stale-browsers.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:baseline": "BASELINE_REGEN=1 vitest run",
    "test:catalog": "vitest run src/__tests__/catalog-smoke.test.ts",
    "test:charts": "vitest run src/__tests__/chart-real-data.test.ts",
    "test:splits": "vitest run src/__tests__/split-real-data.test.ts",
    "test:timelines": "vitest run src/__tests__/horizontal-timeline-real-data.test.ts",
    "test:visual": "vitest run src/__tests__/templates.test.ts",
    "test:real-data": "vitest run src/__tests__/*-real-data.test.ts",
    "test:unit": "vitest run src/__tests__/lint-conventions.test.ts src/__tests__/useCameraStagger.test.ts src/__tests__/EpisodeSeries.test.ts src/__tests__/useBeatSync.test.ts src/__tests__/useEpisodeColorEmphasis.test.ts src/__tests__/useDirection.test.ts src/__tests__/episode-integrity.test.ts src/__tests__/remotion-version-lock.test.ts src/__tests__/animation.test.ts src/__tests__/mapUtils-labelStack.test.ts src/__tests__/useCompositionAnimation.test.ts src/__tests__/MapGL.props.test.ts src/__tests__/audit-direction-fields.test.ts src/__tests__/stepFramework.test.ts src/__tests__/useStepFramework.test.ts src/__tests__/template-coverage.test.ts",
    "test:episode": "vitest run src/__tests__/episode-integrity.test.ts",
    "test:episode-smoke": "vitest run src/__tests__/full-episode-smoke.test.ts --testNamePattern='frame 0'",
    "test:episode-smoke-deep": "vitest run src/__tests__/full-episode-smoke.test.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "create-template": "node scripts/create-template.mjs",
    "lint": "node scripts/lint-conventions.mjs",
    "lint:fix": "node scripts/lint-conventions.mjs --fix",
    "lint:manifest": "python3 ../tools/lint/manifest_lint.py",
    "lint:concepts": "python3 ../tools/concepts/lookup.py validate",
    "lint:direction": "node scripts/audit-direction-fields.mjs --strict",
    "lint:polish": "python3 scripts/lint-templates.py",
    "lint:source": "node scripts/lint-templates.mjs",
    "deploy": "node scripts/deploy-lambda.mjs",
    "deploy:teardown": "node scripts/deploy-lambda.mjs --teardown",
    "render:lambda": "node scripts/render-lambda.mjs",
    "thumbnails": "node scripts/generate-thumbnails.mjs",
    "shorts": "node scripts/render-shorts.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@remotion/cli": "4.0.457",
    "@remotion/google-fonts": "4.0.457",
    "@remotion/lambda": "4.0.457",
    "@remotion/layout-utils": "4.0.457",
    "@remotion/player": "4.0.457",
    "@remotion/sfx": "4.0.457",
    "@remotion/transitions": "4.0.457",
    "@types/d3-geo": "^3.1.0",
    "@types/react-dom": "^19.2.3",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-scale-chromatic": "^3.0.0",
    "mapbox-gl": "^3.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.1",
    "remotion": "4.0.457",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@remotion/bundler": "4.0.457",
    "@remotion/renderer": "4.0.457",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-scale": "^4.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^25.6.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/topojson-client": "^3.1.0",
    "@types/topojson-specification": "^1.0.5",
    "ajv": "^8.20.0",
    "happy-dom": "^20.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
