{
  "name": "geopolitics-video-templates",
  "version": "1.0.0",
  "description": "Remotion template library for geopolitics video production",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render",
    "preview": "npx remotion preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:baseline": "rm -rf src/__tests__/baselines && vitest run",
    "snapshot": "node scripts/snapshot.mjs",
    "create-template": "node scripts/create-template.mjs",
    "lint": "node scripts/lint-conventions.mjs",
    "lint:fix": "node scripts/lint-conventions.mjs --fix",
    "deploy": "node scripts/deploy-lambda.mjs",
    "deploy:teardown": "node scripts/deploy-lambda.mjs --teardown",
    "render:lambda": "node scripts/render-lambda.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@remotion/cli": "^4.0.451",
    "@remotion/google-fonts": "^4.0.451",
    "@remotion/lambda": "^4.0.451",
    "@remotion/light-leaks": "^4.0.456",
    "@remotion/player": "^4.0.451",
    "@remotion/sfx": "^4.0.456",
    "@remotion/transitions": "^4.0.451",
    "d3-interpolate": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-scale-chromatic": "^3.0.0",
    "mapbox-gl": "^3.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-map-gl": "^8.1.1",
    "remotion": "^4.0.451",
    "topojson-client": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.451",
    "@remotion/renderer": "^4.0.451",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-scale": "^4.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/topojson-client": "^3.1.0",
    "playwright": "^1.40.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
