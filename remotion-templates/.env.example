# remotion-templates/.env.example — Mapbox token for map renders.
#
# Required by:
#   · src/components/MapGL.tsx     (the shared deck.gl + Mapbox wrapper)
#   · scripts/render-episode.mjs   (passes through to all map compositions)
#   · src/__tests__/map-real-data.test.ts (skipped when not present)
#
# Without this token, all map templates render with blank tiles. The token
# must have access to the Mapbox Standard style (or the custom Meridian
# Studio styles documented in tools/mapbox-meridian-setup.md).
#
# Copy:  cp remotion-templates/.env.example remotion-templates/.env
# Then edit with the real token. Real .env is gitignored.

# Public-scoped token (pk.*) — safe to embed in browser-rendered builds.
# Get one: https://account.mapbox.com/access-tokens/
# Required scopes: styles:read, tilesets:read, fonts:read, datasets:read.
MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# ─── Meridian custom Mapbox Studio styles (optional) ──────────────────────
# When set, MapGL uses these in place of the default mapbox://styles/...
# variants. Setup procedure: tools/mapbox-meridian-setup.md (2-3 hour
# manual procedure in Mapbox Studio web UI). Until set, the code falls
# back to dark-v11 / light-v11 — episodes still render, just less branded.
#
# MAPBOX_MERIDIAN_LIGHT_STYLE=mapbox://styles/<your-username>/<style-id>
# MAPBOX_MERIDIAN_DARK_STYLE=mapbox://styles/<your-username>/<style-id>
# MAPBOX_MERIDIAN_SEPIA_STYLE=mapbox://styles/<your-username>/<style-id>
# MAPBOX_MERIDIAN_TONER_STYLE=mapbox://styles/<your-username>/<style-id>
