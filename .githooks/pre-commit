#!/usr/bin/env bash
# Pre-commit gate: typecheck on changed *.ts/*.tsx, pytest on changed *.py,
# convention lint on changed template/component files, JSON validation on
# changed JSON, manifest doctrine + concept registry on their dedicated files.
# Activate once with:
#   git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

TS_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
TEMPLATE_TS_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^remotion-templates/src/(templates|components)/.*\.(ts|tsx)$' || true)
PY_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
JSON_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json$' | grep -v 'package-lock\.json' || true)
MANIFEST_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'data/episodes/[^/]+/assembly-manifest\.json$' || true)
CONCEPTS_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^data/concepts\.json$' || true)
PIPELINE_STATE_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^episodes/pipeline-state\.json$' || true)

if [ -n "$TS_CHANGED" ]; then
  echo "→ TypeScript typecheck (TS files changed)"
  (cd remotion-templates && npx tsc --noEmit)
fi

if [ -n "$TEMPLATE_TS_CHANGED" ]; then
  echo "→ Convention lint (template/component files changed)"
  # lint-conventions.mjs is fast (<1s) and scans the whole tree; running it
  # here catches hex literals, hook misuse, and bare durationSec at commit
  # time instead of waiting for CI. It doesn't accept per-file args (whole-
  # tree scan is the design), so we invoke it once whenever any template or
  # component file changed.
  (cd remotion-templates && node scripts/lint-conventions.mjs)
fi

if [ -n "$PY_CHANGED" ]; then
  echo "→ Python lint (ruff) on changed files"
  # ruff is fast (<1s on the changed-files subset); catches the bare-`except
  # Exception` / unused-import / bad-zip-strict patterns the codebase has been
  # cleaned to zero. Per pyproject.toml [tool.ruff]. Skip silently if ruff
  # isn't installed (e.g. fresh clone before `pip install -e '.[dev]'`).
  if python3 -m ruff --version >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    python3 -m ruff check $PY_CHANGED
  else
    echo "  (ruff not installed; skipping lint. install with: pip install -e '.[dev]')"
  fi
  echo "→ Python tests (Python files changed)"
  python3 -m pytest tools/ -q
fi

if [ -n "$JSON_CHANGED" ]; then
  echo "→ JSON validation (JSON files changed)"
  # shellcheck disable=SC2086
  python3 tools/validate_data.py --files $JSON_CHANGED
fi

if [ -n "$MANIFEST_CHANGED" ]; then
  echo "→ Assembly-manifest doctrine lint (manifests changed)"
  # shellcheck disable=SC2086
  python3 tools/lint/manifest_lint.py $MANIFEST_CHANGED
fi

if [ -n "$CONCEPTS_CHANGED" ]; then
  echo "→ Concept-registry validation (data/concepts.json changed)"
  python3 tools/concepts/lookup.py validate
fi

if [ -n "$PIPELINE_STATE_CHANGED" ]; then
  echo "→ Pipeline state changed; auto-syncing stateEnteredAt + refreshing dashboards"
  # 1. For any episode whose `state` field changed since HEAD, bump
  #    `stateEnteredAt` to today so days-in-state stays honest.
  CHANGED_SLUGS=$(python3 tools/sync_pipeline_state.py)
  if [ -n "$CHANGED_SLUGS" ]; then
    echo "  state advanced for: $(echo "$CHANGED_SLUGS" | tr '\n' ' ')"
    git add episodes/pipeline-state.json
    # sync_pipeline_state also appended to each changed episode's append-only
    # _state-history.jsonl audit trail — stage those too.
    find episodes -maxdepth 2 -name '_state-history.jsonl' -print0 | xargs -0 -r git add
  fi
  # 2. Enforce source-of-truth consistency. CLAUDE.md + project/IDEAS.md mirror
  #    pipeline-state.json but are hand-maintained (can't be auto-derived
  #    safely), so a mismatch BLOCKS the commit with a clear fix message —
  #    `set -e` aborts here on non-zero exit.
  python3 tools/pipeline_validator.py --check-sources
  # 3. Regenerate ALL derived dashboards (PIPELINE.md At-a-glance + Topics,
  #    per-episode _status.md, AND PIPELINE.html) then re-stage them so the
  #    committed snapshot matches the new state. HTML is tracked + lint-gated,
  #    so it must be refreshed here too (was previously left stale).
  python3 tools/pipeline_validator.py --write-status --update-tracker >/dev/null
  python3 tools/pipeline_validator.py --emit-html >/dev/null
  git add episodes/PIPELINE.md episodes/PIPELINE.html
  # _status.md files only exist for episodes that have a folder; glob may
  # not match anything, so use find + xargs to stay quiet.
  find episodes -maxdepth 2 -name '_status.md' -print0 | xargs -0 -r git add
fi

# Manifest staleness informational pass: when episode-level source files
# (script, shot-list, narration WAV, etc.) change, run invalidate.py --soft
# to surface any downstream artifacts that are now stale. Non-blocking
# (--soft exits 0 always) — operator decides whether to act before shipping.
# Derive affected slugs from staged episode paths (episodes/<slug>/...).
EPISODE_FILES_CHANGED=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^episodes/[^/]+/(script|shot-list|visual-spec|audio|narration)' || true)
if [ -n "$EPISODE_FILES_CHANGED" ]; then
  AFFECTED_SLUGS=$(echo "$EPISODE_FILES_CHANGED" \
    | sed -E 's|^episodes/([^/]+)/.*|\1|' | sort -u)
  for slug in $AFFECTED_SLUGS; do
    echo "→ Manifest staleness check (episode files changed: $slug)"
    python3 tools/assembly/invalidate.py --soft --episode="$slug" || true
  done
fi

if [ -z "$TS_CHANGED" ] && [ -z "$TEMPLATE_TS_CHANGED" ] && [ -z "$PY_CHANGED" ] && [ -z "$JSON_CHANGED" ] && [ -z "$MANIFEST_CHANGED" ] && [ -z "$CONCEPTS_CHANGED" ] && [ -z "$PIPELINE_STATE_CHANGED" ] && [ -z "$EPISODE_FILES_CHANGED" ]; then
  echo "  (no .ts/.tsx/.py/.json/episode changes, skipping checks)"
fi

echo "✓ pre-commit checks passed"
