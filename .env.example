# Root-level .env.example — top-level / cross-tool API keys.
#
# Tools in this repo follow a per-subdirectory .env convention where it
# makes sense (tools/asset-source/.env, remotion-templates/.env). The
# keys below are read from the SHELL ENVIRONMENT — export them in your
# ~/.zshrc, source this file, or use a tool like direnv.
#
# Copy:    cp .env.example .env  &&  edit  &&  source .env
# Or wire into shell:  export $(grep -v '^#' .env | xargs)
#
# Real .env is gitignored (line 14 of .gitignore). NEVER commit secrets.

# ─── Anthropic (Claude SDK) ────────────────────────────────────────────────
# Used by:
#   · tools/publish/shorts_llm_scorer.py  (LLM-rerank for Shorts proposer)
#   · tools/topic/idea_invalidation.py    (MKBHD-style kill-list pattern)
# Get one: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Twelve Labs (Pegasus 1.2 / Marengo 3.0 video AI) ──────────────────────
# Used by:
#   · tools/episode_watch/episode_watch.py  (post-publish video analysis)
# Get one + index: https://twelvelabs.io/
TWELVELABS_API_KEY=tlk_...
TWELVELABS_INDEX_ID=...

# ─── YouTube Data API v3 ───────────────────────────────────────────────────
# Used by:
#   · tools/learn/analytics_ingest.py     (post-publish analytics)
#   · tools/learn/engagement_metrics.py
# Get one: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# ─── Recraft V3 (AI illustration generation) ───────────────────────────────
# Used by:
#   · tools/recraft/recraft.py
# Get one: https://www.recraft.ai/ → API tab
RECRAFT_API_KEY=...

# ─── fal.ai (Flux 2 Pro stills, Kling video) ───────────────────────────────
# Used by:
#   · tools/ai-video/generate_style_refs.py
# Get one: https://fal.ai/dashboard/keys
FAL_KEY=...

# ─── Hugging Face (model downloads, occasional inference) ──────────────────
# Used by:
#   · tools/assembly/generate_manifest.py (SileroVAD pause detection)
# Get one (free): https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ─── Auphonic (narration mastering) ────────────────────────────────────────
# Used by:
#   · tools/narration/auphonic_submit.py
# Get one: https://auphonic.com/api  (free tier: 2h/mo on free account)
AUPHONIC_API_KEY=...
