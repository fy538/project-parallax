# would fill it. Guard so it doesn't get accidentally committed.
/node_modules/

# Build & render output
remotion-templates/out/
remotion-templates/dist/
remotion-templates/.cache/
remotion-templates/.vite/

# Environment
.env
.env.local
.env.*.local

# AI agent local overrides (personal, not team-shared)
CLAUDE.local.md
.claude/settings.local.json
# Scheduled-task runtime state — per-machine, not team-shared.
.claude/scheduled_tasks.lock

# Git worktrees for parallel work (created by scripts/worktree.sh)
worktrees/

# Logs
*.log

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.coverage
coverage.xml
htmlcov/

# Test artifacts
remotion-templates/src/__tests__/.temp-renders/
remotion-templates/src/__tests__/.temp-renders-catalog/
remotion-templates/test-results.json

# Skill packages (built from SKILL.md source)
*.skill

# Skill development workspaces (eval iteration outputs)
skills/*/research-audit-workspace/

# Auto-generated per-episode artifacts. _status.md IS tracked (the
# per-episode operational dashboard shown to the team); _checkpoint.md
# is the stage-checklist artifact that regenerates on every
# check-episode.sh run and would otherwise show up perpetually as
# untracked. Generated by tools/pipeline_validator.py.
#
# Rule (May 2026 audit #20): every episode under episodes/<slug>/ MUST
# have a tracked _status.md. The pre-commit hook regenerates them via
# `pipeline_validator.py --write-status` whenever pipeline-state.json
# changes, then stages the result. If a new episode is missing one,
# either:
#   1. Run `python tools/pipeline_validator.py --write-status` once, or
#   2. Add a stub `_status.md` to the new episode dir and let the next
#      pipeline-state.json edit refresh it.
episodes/*/_checkpoint.md
